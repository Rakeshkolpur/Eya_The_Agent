# Copy this file to .env and fill in the values. .env is git-ignored.

# Gemini (primary LLM). Get a key at https://aistudio.google.com/apikey
EYA_GEMINI_API_KEY=
EYA_GEMINI_MODEL=gemini-3.8-flash
# Model that turns your speech into text. Measured fastest here: gemini-3.6-flash.
# Comma-separate to set your own fallback order.
EYA_GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash
# Voice models, tried in order. Default: gemini-3.8-flash-lite-tts, gemini-3.8-flash-tts, gemini-2.5-flash-preview-tts
# EYA_TTS_MODELS=

# Local AI through Ollama (no key; nothing leaves the PC). Choose it in Eya: Settings -> Local AI (Ollama). The line below is optional and, if present,
# wins over that choice. Install the model once with:  ollama pull llama3.2:1b
EYA_OLLAMA_URL=http://127.0.0.1:11434
# EYA_OLLAMA_MODEL=llama3.2:1b

# Logging
EYA_LOG_LEVEL=info
