{
  "manifest_version": 3,
  "name": "Eya Browser Bridge",
  "version": "0.1.0",
  "description": "Lets the Eya desktop assistant on this PC see and operate your own browser tabs, using the sessions you are already signed in to. Talks only to Eya on this computer (127.0.0.1).",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Eya Browser Bridge - click for status"
  }
}
